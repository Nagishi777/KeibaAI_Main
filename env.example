# Copy this file to src/buying/.env and replace values locally.
# Never commit or cloud-sync the real .env file.

# Credentials (do not quote unless the value itself requires it)
JRA_INET_ID=replace_me
JRA_KANYUSHA_NO=replace_me
JRA_PIN=replace_me
JRA_PARS_NO=replace_me
BUYING_ACCOUNT_ALIAS=default

# Safety: dry-run never submits the final purchase.
BUYING_MODE=dry-run
BUYING_KILL_SWITCH=true
BUYING_HEADLESS=false
BUYING_LOGIN_URL=https://www.ipat.jra.go.jp/
BUYING_POLL_INTERVAL_SECONDS=15

# Timing (seconds before scheduled post time)
BUYING_DECISION_LEAD_SECONDS=180
BUYING_SUBMIT_DEADLINE_LEAD_SECONDS=120
BUYING_MAX_CLOCK_SKEW_SECONDS=2
BUYING_MAX_ODDS_AGE_SECONDS=180

# Hard limits (set deliberately before live use)
BUYING_ALLOWED_BET_TYPES=win,place,bracket_quinella
BUYING_MIN_BET_YEN=100
BUYING_MAX_BET_YEN=100
BUYING_MAX_RACE_YEN=100
BUYING_MAX_DAY_YEN=100
BUYING_MAX_SESSION_YEN=100
BUYING_MAX_BETS_PER_RACE=1

# Local paths
BUYING_SCHEDULE_DIR=data/processed/races
BUYING_ODDS_DIR=data/processed/realtime_odds
BUYING_DATA_DIR=data/processed/buying
